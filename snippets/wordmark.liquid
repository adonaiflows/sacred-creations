{%- comment -%}
  The Sacred Creations logo (seed of life with "Sacred Creations · Handmade with intention").
  Pass light: true on dark backgrounds (white lettering); otherwise the lettering is dark ink.
  Optional class sets the size (default: header size).
{%- endcomment -%}
{%- liquid
  assign file = 'sc-logo-dark.webp'
  if light
    assign file = 'sc-logo-light.webp'
  endif
  assign size = class | default: 'h-[68px] w-auto sm:h-24'
  if light and class == blank
    assign size = size | append: ' drop-shadow-[0_1px_10px_rgba(0,0,0,0.5)]'
  endif
-%}
<img src="{{ file | asset_url }}" alt="{{ shop.name }}, handmade with intention" width="771" height="456" class="{{ size }}" fetchpriority="high">
