          "settings": {
            "name": "Kaylee Romero",
            "role": "Co-founder · Formulator & artist",
            "body": "<p>Kaylee is the creator and the artist, the sacred feminine of Sacred Creations. She receives the visions, formulates the skincare, makes the ceramics and hand-crafts every bottle of Liquid Gold.</p>"
          }
        },
        "people-2": {
          "type": "person",
          "settings": {
            "name": "Adonai Romero",
            "role": "Co-founder · Business & design",
            "body": "<p>Adonai is the structure, the sacred masculine. He builds the avenues that carry Kaylee's art into the world: the website, the business, the paperwork and the day-to-day. A designer too, he shapes the look of Sacred Creations and will lead its clothing line.</p>"
          }
        }
      },
