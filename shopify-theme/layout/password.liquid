<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'marcellus.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'jost.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="font-sans">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
