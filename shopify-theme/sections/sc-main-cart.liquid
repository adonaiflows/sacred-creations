<section class="wall min-h-svh" aria-labelledby="cart-title">
  <div class="mx-auto max-w-3xl px-4 pt-32 pb-24 sm:px-6">
    <h1 id="cart-title" class="font-display text-4xl md:text-5xl">Your cart</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="paper mt-10 rounded-[28px] p-7 ring-1 ring-ink/10 md:p-10">
        <ul class="divide-y divide-ink/10">
          {%- for item in cart.items -%}
            <li class="grid grid-cols-[72px_1fr_auto] items-center gap-4 py-5">
              {%- if item.image -%}
                {{ item.image | image_url: width: 160 | image_tag: class: 'h-20 w-[72px] rounded-xl object-contain', loading: 'lazy' }}
              {%- else -%}<span></span>{%- endif -%}
              <div>
                <a href="{{ item.url }}" class="font-display text-xl hover:text-copper-deep">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="text-sm text-muted">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="mt-2 flex items-center gap-3">
                  <label class="sr-only" for="qty-{{ item.key }}">Quantity</label>
                  <input id="qty-{{ item.key }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}" class="h-10 w-20 rounded-full border border-ink/20 bg-parchment px-4">
                  <a href="{{ item.url_to_remove }}" class="text-xs tracking-[0.16em] text-muted uppercase underline underline-offset-4">Remove</a>
                </div>
              </div>
              <p class="font-display text-xl">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
        <div class="mt-6 flex flex-col items-end gap-4 border-t border-ink/10 pt-6">
          <p class="font-display text-2xl">Subtotal {{ cart.total_price | money }}</p>
          <p class="text-sm text-muted">Shipping and taxes are added at checkout.</p>
          <div class="flex flex-wrap justify-end gap-3">
            <button type="submit" name="update" class="min-h-12 rounded-full border border-ink/20 px-6 text-sm tracking-[0.12em] uppercase">Update</button>
            <button type="submit" name="checkout" class="min-h-12 rounded-full bg-copper px-8 text-[15px] font-medium tracking-[0.08em] text-parchment uppercase hover:bg-copper-deep">Check out</button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="w-full max-w-sm">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <p class="mt-6 text-ink-soft">Your cart is empty.</p>
      <div class="mt-8">{% render 'buy-button', location: 'empty-cart' %}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "tag": "div", "settings": [] }
{% endschema %}
