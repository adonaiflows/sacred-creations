<section class="wall min-h-svh">
  <div class="mx-auto max-w-3xl px-4 pt-32 pb-24 sm:px-6">
    <h1 class="font-display text-4xl md:text-5xl">Your account</h1>
    <div class="paper mt-8 rounded-[28px] p-7 ring-1 ring-ink/10 md:p-10">
      <p class="font-display text-2xl">{{ customer.name }}</p>
      <p class="text-muted">{{ customer.email }}</p>
      <div class="mt-4 flex flex-wrap gap-6">
        <a href="{{ routes.account_addresses_url }}" class="text-sm tracking-[0.12em] text-ink-soft uppercase underline underline-offset-4 hover:text-copper-deep">Addresses ({{ customer.addresses_count }})</a>
        <a href="{{ routes.account_logout_url }}" class="text-sm tracking-[0.12em] text-ink-soft uppercase underline underline-offset-4 hover:text-copper-deep">Log out</a>
      </div>
      <h2 class="mt-10 font-display text-2xl">Orders</h2>
      {%- paginate customer.orders by 20 -%}
        <ul class="mt-4 divide-y divide-ink/10">
          {%- for order in customer.orders -%}
            <li class="flex flex-wrap items-center justify-between gap-3 py-4">
              <a href="{{ order.customer_url }}" class="font-display text-xl hover:text-copper-deep">{{ order.name }}</a>
              <span class="text-sm text-muted">{{ order.created_at | date: '%B %-d, %Y' }} · {{ order.fulfillment_status_label }}</span>
              <span>{{ order.total_price | money }}</span>
            </li>
          {%- else -%}
            <li class="py-4 text-muted">You haven't placed any orders yet.</li>
          {%- endfor -%}
        </ul>
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{"name": "Account: account", "tag": "div", "settings": []}
{% endschema %}
