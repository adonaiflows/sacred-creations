<section class="wall min-h-svh">
  <div class="mx-auto max-w-md px-4 pt-32 pb-24 sm:px-6">
    <h1 class="font-display text-4xl md:text-5xl">Log in</h1>
    <div class="paper mt-8 rounded-[28px] p-7 ring-1 ring-ink/10 md:p-10">
      {%- form 'customer_login', class: 'space-y-5' -%}
        {%- if form.errors -%}<div class="rounded-2xl bg-copper/10 p-4 text-ink" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">Email<input type="email" name="customer[email]" autocomplete="email"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">Password<input type="password" name="customer[password]" autocomplete="current-password"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-copper px-7 py-3.5 text-[15px] font-medium tracking-[0.08em] text-parchment uppercase hover:bg-copper-deep">Log in</button>
      {%- endform -%}
      <div class="mt-6 flex flex-wrap gap-6">
        <a href="{{ routes.account_register_url }}" class="text-sm tracking-[0.12em] text-ink-soft uppercase underline underline-offset-4 hover:text-copper-deep">Create an account</a>
      </div>
      <details class="mt-8 border-t border-ink/10 pt-6">
        <summary class="cursor-pointer text-sm tracking-[0.12em] uppercase">Forgot your password?</summary>
        {%- form 'recover_customer_password', class: 'mt-4 space-y-4' -%}
          {%- if form.posted_successfully? -%}<p role="status">We've sent you an email with a link to reset your password.</p>{%- endif -%}
          {%- if form.errors -%}<div class="rounded-2xl bg-copper/10 p-4 text-ink" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label class="block text-xs tracking-[0.2em] text-muted uppercase">Email<input type="email" name="email" autocomplete="email"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
          <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-copper px-7 py-3.5 text-[15px] font-medium tracking-[0.08em] text-parchment uppercase hover:bg-copper-deep">Send reset link</button>
        {%- endform -%}
      </details>
      {%- if shop.checkout.guest_login -%}
        {%- form 'guest_login', class: 'mt-8 border-t border-ink/10 pt-6' -%}
          <button type="submit" class="text-sm tracking-[0.12em] text-ink-soft uppercase underline underline-offset-4 hover:text-copper-deep">Continue as a guest</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{"name": "Account: login", "tag": "div", "settings": []}
{% endschema %}
