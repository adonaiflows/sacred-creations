<section class="paper border-y border-ink/10" aria-labelledby="stockists-title-{{ section.id }}">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      {% render 'eyebrow', text: section.settings.eyebrow %}
      <h2 id="stockists-title-{{ section.id }}" class="font-display text-3xl md:text-4xl">
        {{ section.settings.heading }} <span class="accent text-copper">{{ section.settings.heading_accent }}</span>
      </h2>
    </div>
    <ul class="space-y-1 md:text-right">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <p class="font-display text-2xl">{{ block.settings.name }}</p>
          <p class="text-sm tracking-[0.16em] text-muted uppercase">{{ block.settings.place }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Stockists",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Find it in person" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the shelf in" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "Albuquerque." }
  ],
  "blocks": [
    {
      "type": "stockist",
      "name": "Stockist",
      "settings": [
        { "type": "text", "id": "name", "label": "Shop name", "default": "Daily Rituals / Stickks & Stones" },
        { "type": "text", "id": "place", "label": "Town", "default": "Albuquerque, New Mexico" }
      ]
    }
  ],
  "presets": [{ "name": "Stockists" }]
}
{% endschema %}
