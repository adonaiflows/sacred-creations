{%- comment -%} Tabs instead of an FAQ list. Each block is one tab. {%- endcomment -%}
<section id="details" class="paper border-y border-ink/10" aria-labelledby="details-title-{{ section.id }}">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 md:py-28">
    {% render 'eyebrow', text: section.settings.eyebrow %}
    <h2 id="details-title-{{ section.id }}" class="font-display text-4xl md:text-5xl">
      {{ section.settings.heading }} <span class="accent text-copper">{{ section.settings.heading_accent }}</span>
    </h2>
    <div class="mt-10" data-tabs>
      <div role="tablist" aria-label="Product details" class="grid grid-cols-2 gap-x-6 border-b border-ink/15 sm:flex sm:gap-10">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            id="tab-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="panel-{{ block.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            class="-mb-px min-h-12 shrink-0 border-b-2 border-transparent pb-3 text-left text-sm tracking-[0.16em] text-muted uppercase transition-colors hover:text-ink aria-selected:border-copper aria-selected:text-ink"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        <div role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}" tabindex="0" class="pt-8" {% unless forloop.first %}hidden{% endunless %}>
          <div class="grid gap-6 md:grid-cols-[1fr_1.2fr]">
            <p class="font-display text-2xl leading-snug">{{ block.settings.lead }}</p>
            <div class="rte space-y-4 leading-relaxed text-muted">{{ block.settings.body }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Details tabs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "details." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab name", "default": "Tab" },
        { "type": "text", "id": "lead", "label": "Short answer" },
        { "type": "richtext", "id": "body", "label": "Full answer" }
      ]
    }
  ],
  "presets": [{ "name": "Details tabs" }]
}
{% endschema %}
