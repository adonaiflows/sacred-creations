<section class="wall min-h-svh">
  <div class="mx-auto max-w-md px-4 pt-32 pb-24 sm:px-6">
    <h1 class="font-display text-4xl md:text-5xl">Create an account</h1>
    <div class="paper mt-8 rounded-[28px] p-7 ring-1 ring-ink/10 md:p-10">
      {%- form 'create_customer', class: 'space-y-5' -%}
        {%- if form.errors -%}<div class="rounded-2xl bg-copper/10 p-4 text-ink" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">First name<input type="text" name="customer[first_name]" autocomplete="given-name"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">Last name<input type="text" name="customer[last_name]" autocomplete="family-name"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">Email<input type="email" name="customer[email]" autocomplete="email"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <label class="block text-xs tracking-[0.2em] text-muted uppercase">Password<input type="password" name="customer[password]" autocomplete="new-password"  class="mt-2 min-h-12 w-full rounded-full border border-ink/20 bg-parchment px-5"></label>
        <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-copper px-7 py-3.5 text-[15px] font-medium tracking-[0.08em] text-parchment uppercase hover:bg-copper-deep">Create account</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{"name": "Account: register", "tag": "div", "settings": []}
{% endschema %}
