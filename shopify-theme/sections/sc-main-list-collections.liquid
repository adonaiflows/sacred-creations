<section class="wall min-h-svh">
  <div class="mx-auto max-w-6xl px-4 pt-32 pb-24 sm:px-6">
    <h1 class="text-center font-display text-4xl md:text-5xl">Shop</h1>
    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {%- for c in collections -%}
        <li>
          <a href="{{ c.url }}" class="tag block rounded-sm p-7 text-center hover:text-copper-deep">
            <span class="block font-display text-2xl">{{ c.title }}</span>
            <span class="block text-xs tracking-[0.2em] text-ink-soft uppercase">{{ c.products_count }} {{ c.products_count | pluralize: 'piece', 'pieces' }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Collections list", "tag": "div", "settings": [] }
{% endschema %}
