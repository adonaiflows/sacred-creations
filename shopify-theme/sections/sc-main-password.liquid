<section class="wall flex min-h-svh items-center">
  <div class="mx-auto max-w-md px-4 py-24 text-center sm:px-6">
    {% render 'wordmark' %}
    {%- if shop.password_message != blank -%}<p class="mt-8 text-ink-soft">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'mt-8 flex gap-3' -%}
      <label for="password" class="sr-only">Password</label>
      <input id="password" type="password" name="password" autocomplete="current-password" class="min-h-12 flex-1 rounded-full border border-ink/20 bg-parchment px-5" placeholder="Password">
      <button class="min-h-12 rounded-full bg-copper px-6 text-sm tracking-[0.12em] text-parchment uppercase">Enter</button>
      {%- if form.errors -%}<div class="text-sm text-copper-deep">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password", "tag": "div", "settings": [] }
{% endschema %}
