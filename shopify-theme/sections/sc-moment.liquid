{%- comment -%} A full-height photo in an arch beside a quiet call to buy. {%- endcomment -%}
<section class="grid md:min-h-svh md:grid-cols-2" aria-labelledby="moment-title-{{ section.id }}">
  <div class="paper flex items-center justify-center px-4 py-12 sm:px-6 md:py-16">
    {% render 'sc-image', image: section.settings.image, asset: 'bottle-woodchips', widths: '800,1600', width: 1600, height: 2844, alt: section.settings.image_alt, sizes: '(min-width: 768px) 46svh, 90vw', class: 'h-auto w-full max-w-[420px] rounded-t-[999px] rounded-b-[28px] shadow-[0_40px_80px_-40px_rgba(46,30,20,0.6)] ring-1 ring-ink/10 md:h-[84svh] md:w-auto md:max-w-none' %}
  </div>
  <div class="sunwash flex flex-col justify-center px-4 py-20 sm:px-6 md:px-12 lg:px-20" data-reveal>
    {% render 'eyebrow', text: section.settings.eyebrow %}
    <h2 id="moment-title-{{ section.id }}" class="font-display text-4xl leading-tight text-balance md:text-[3.4rem]">
      {{ section.settings.heading }} <span class="accent text-copper">{{ section.settings.heading_accent }}</span>
    </h2>
    {%- if section.settings.text != blank -%}
      <p class="mt-6 max-w-md text-muted md:text-lg">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="mt-10 self-start">
      {% render 'buy-button', location: 'mid' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Photo and buy",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave empty to use the bottle on wood chips." },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Close-up of Liquid Gold on wood chips: frosted glass with golden oil, a bamboo dropper and the parchment label" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Your ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give your skin a moment" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "that's just for you." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Apply 2–3 drops to clean, slightly damp skin, morning or night. A little goes a long way: one 1 oz bottle typically lasts 6–8 weeks of daily use." }
  ],
  "presets": [{ "name": "Photo and buy" }]
}
{% endschema %}
