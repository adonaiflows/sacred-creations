{%- comment -%}
  Editorial text chapter for the About page: heading on the left, story on the right, an optional
  pull quote, and optional numbered points (values, promises) underneath.
{%- endcomment -%}
{%- if section.settings.only_on_page == blank or page.handle == section.settings.only_on_page -%}
<section class="{% if section.settings.surface == 'paper' %}paper border-y border-ink/10{% else %}wall{% endif %} relative overflow-hidden" aria-labelledby="chapter-title-{{ section.id }}">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <div data-reveal>
        {% render 'eyebrow', text: section.settings.eyebrow, color: 'text-copper-deep' %}
        <h2 id="chapter-title-{{ section.id }}" class="font-display text-4xl leading-tight text-balance md:text-5xl">
          {{ section.settings.heading }} <span class="accent text-copper-deep">{{ section.settings.heading_accent }}</span>
        </h2>
      </div>
      <div data-reveal>
        <div class="rte space-y-5 leading-relaxed text-ink-soft md:text-lg">{{ section.settings.text }}</div>
        {%- if section.settings.quote != blank -%}
          <blockquote class="mt-10 border-l-2 border-copper/60 pl-6 font-display text-2xl leading-snug text-ink md:text-3xl">
            {{ section.settings.quote }}
            {%- if section.settings.quote_by != blank -%}
              <footer class="mt-3 font-sans text-xs tracking-[0.24em] text-ink-soft uppercase">{{ section.settings.quote_by }}</footer>
            {%- endif -%}
          </blockquote>
        {%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {%- for block in section.blocks -%}
          <li class="tag rounded-sm p-7" data-reveal {{ block.shopify_attributes }}>
            <p class="font-display text-3xl text-copper">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <h3 class="mt-3 font-display text-2xl">{{ block.settings.title }}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "About chapter",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "surface", "label": "Background", "default": "wall", "options": [ { "value": "wall", "label": "Limewash wall" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It began" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "at home." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "quote", "label": "Pull quote" },
    { "type": "text", "id": "quote_by", "label": "Pull quote, who said it" },
    { "type": "text", "id": "only_on_page", "label": "Only show on page (handle)", "info": "Used on the default page template, e.g. about. Leave empty to always show." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "About chapter" } ]
}
{% endschema %}
