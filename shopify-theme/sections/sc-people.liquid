<section class="paper border-y border-ink/10" aria-labelledby="people-title-{{ section.id }}">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    {% render 'eyebrow', text: section.settings.eyebrow %}
    <h2 id="people-title-{{ section.id }}" class="font-display text-4xl md:text-5xl">
      {{ section.settings.heading }} <span class="accent text-copper">{{ section.settings.heading_accent }}</span>
    </h2>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {%- for block in section.blocks -%}
        <li class="tag rounded-sm p-7 md:p-9" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400, 800', sizes: '(min-width: 768px) 40vw, 85vw', class: 'mb-6 aspect-[4/3] w-full rounded-sm object-cover', loading: 'lazy' }}
          {%- endif -%}
          <p class="text-xs tracking-[0.24em] text-ink-soft uppercase">{{ block.settings.role }}</p>
          <h3 class="mt-2 font-display text-3xl">{{ block.settings.name }}</h3>
          <div class="rte mt-3 leading-relaxed text-ink-soft">{{ block.settings.body }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "People",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Who we are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two people," },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "one oil." }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "richtext", "id": "body", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "People" }]
}
{% endschema %}
