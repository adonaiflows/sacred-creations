{%- comment -%} The Sacred Creation Ritual: Opening, Creation, Refinement as numbered cards. {%- endcomment -%}
<section id="ritual" class="on-dark relative overflow-hidden bg-ink text-parchment" aria-labelledby="ritual-title-{{ section.id }}">
  {% render 'spirograph', class: 'pointer-events-none absolute -top-40 -right-40 h-[640px] w-[640px] text-sandstone/15' %}
  <div class="relative mx-auto flex min-h-svh max-w-6xl flex-col justify-center px-4 py-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      {% render 'eyebrow', text: section.settings.eyebrow, color: 'text-sandstone' %}
      <h2 id="ritual-title-{{ section.id }}" class="font-display text-4xl leading-tight md:text-[3.4rem]">
        {{ section.settings.heading }} <span class="accent text-sandstone">{{ section.settings.heading_accent }}</span>
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="mt-5 max-w-md leading-relaxed text-parchment/75">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <ol class="mt-14 grid gap-5 md:grid-cols-3">
      {%- for block in section.blocks -%}
        <li class="flex flex-col rounded-[28px] border border-parchment/15 bg-ink-soft/60 p-8" data-reveal {{ block.shopify_attributes }}>
          <span class="font-display text-6xl text-sandstone/80">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <p class="mt-10 text-xs tracking-[0.24em] text-sandstone uppercase">{{ block.settings.phase }}</p>
          <h3 class="mt-1 font-display text-3xl">{{ block.settings.title }}</h3>
          <p class="mt-3 leading-relaxed text-parchment/75">{{ block.settings.body }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.affirmation != blank -%}
      <figure class="mt-16 max-w-3xl border-l border-sandstone/50 pl-6" data-reveal>
        <p class="text-xs tracking-[0.28em] text-sandstone uppercase">Affirmation for daily ritual</p>
        <blockquote class="mt-3 font-display text-2xl leading-snug md:text-3xl">&ldquo;{{ section.settings.affirmation }}&rdquo;</blockquote>
        <figcaption class="mt-3 text-sm text-parchment/70">{{ section.settings.caption }}</figcaption>
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ritual",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "The Sacred Creation Ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made slowly," },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "on purpose." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Liquid Gold is not simply manufactured skincare. Every bottle is made by hand in New Mexico and taken through the same three steps before it reaches you." },
    { "type": "textarea", "id": "affirmation", "label": "Affirmation", "default": "I anoint this temple with ancient light. With every drop, I release the old and reveal my true radiance. I am grounded. I am pure. I am golden." },
    { "type": "text", "id": "caption", "label": "Affirmation caption", "default": "From the Liquid Gold label" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "phase", "label": "Phase", "default": "Opening" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cleansed" },
        { "type": "textarea", "id": "body", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Ritual" }]
}
{% endschema %}
