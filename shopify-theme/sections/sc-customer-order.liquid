<section class="wall min-h-svh">
  <div class="mx-auto max-w-3xl px-4 pt-32 pb-24 sm:px-6">
    <h1 class="font-display text-4xl md:text-5xl">Order {{ order.name }}</h1>
    <div class="paper mt-8 rounded-[28px] p-7 ring-1 ring-ink/10 md:p-10">
      <p class="text-muted">Placed {{ order.created_at | date: '%B %-d, %Y' }}{%- if order.cancelled %} · Cancelled{% endif -%}</p>
      <ul class="mt-6 divide-y divide-ink/10">
        {%- for item in order.line_items -%}
          <li class="flex justify-between gap-4 py-4">
            <span>{{ item.title }} × {{ item.quantity }}</span>
            <span>{{ item.final_line_price | money }}</span>
          </li>
        {%- endfor -%}
      </ul>
      <dl class="mt-6 space-y-2 border-t border-ink/10 pt-6">
        <div class="flex justify-between"><dt>Subtotal</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
        {%- for shipping_method in order.shipping_methods -%}
          <div class="flex justify-between"><dt>Shipping ({{ shipping_method.title }})</dt><dd>{{ shipping_method.price | money }}</dd></div>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <div class="flex justify-between"><dt>{{ tax_line.title }}</dt><dd>{{ tax_line.price | money }}</dd></div>
        {%- endfor -%}
        <div class="flex justify-between font-display text-xl"><dt>Total</dt><dd>{{ order.total_price | money }}</dd></div>
      </dl>
      {%- if order.shipping_address -%}
        <h2 class="mt-8 font-display text-xl">Shipping to</h2>
        <div class="mt-2 text-muted">{{ order.shipping_address | format_address }}</div>
      {%- endif -%}
      <a href="{{ routes.account_url }}" class="mt-8 inline-block text-sm tracking-[0.12em] uppercase underline underline-offset-4">Back to your account</a>
    </div>
  </div>
</section>

{% schema %}
{"name": "Account: order", "tag": "div", "settings": []}
{% endschema %}
