<section id="final-cta" class="on-dark relative flex min-h-[80svh] items-center overflow-hidden bg-copper-deep text-parchment" aria-labelledby="final-title-{{ section.id }}">
  {% render 'spirograph', class: 'pointer-events-none absolute top-1/2 left-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-1/2 text-parchment/10' %}
  <div class="relative mx-auto flex max-w-4xl flex-col items-center px-4 py-20 text-center sm:px-6">
    {% render 'logo-mark', class: 'mb-8 h-14 w-14 text-sandstone' %}
    <h2 id="final-title-{{ section.id }}" class="font-display text-5xl leading-tight md:text-7xl">
      {{ section.settings.heading }} <span class="accent text-sandstone">{{ section.settings.heading_accent }}</span>
    </h2>
    {%- if section.settings.text != blank -%}
      <p class="mt-5 max-w-md text-parchment/80">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="mt-10">
      {% render 'buy-button', product: product, location: 'footer', style: 'light' %}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="mt-4 text-sm text-parchment/75">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing call to buy",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic part", "default": "when you are." },
    { "type": "text", "id": "text", "label": "Text", "default": "I am grounded. I am pure. I am golden." },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "Secure checkout through Shopify" }
  ],
  "presets": [{ "name": "Closing call to buy" }]
}
{% endschema %}
