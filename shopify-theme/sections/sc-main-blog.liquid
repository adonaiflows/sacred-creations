<section class="wall min-h-svh">
  <div class="mx-auto max-w-4xl px-4 pt-32 pb-24 sm:px-6">
    <h1 class="font-display text-4xl md:text-5xl">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {%- for article in blog.articles -%}
          <li class="paper rounded-[28px] p-7 ring-1 ring-ink/10">
            <a class="font-display text-2xl hover:text-copper-deep" href="{{ article.url }}">{{ article.title }}</a>
            <p class="mt-2 text-sm text-muted">{{ article.published_at | date: '%B %-d, %Y' }}</p>
            <p class="mt-3 text-ink-soft">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "div", "settings": [] }
{% endschema %}
