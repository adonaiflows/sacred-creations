{%- comment -%} A slow, endless strip of words. The list is printed twice so the loop has no seam. {%- endcomment -%}
{%- capture row -%}
  {%- for block in section.blocks -%}
    <li class="flex items-center gap-10 pr-10 whitespace-nowrap" {{ block.shopify_attributes }}>
      <span>{{ block.settings.text }}</span>
      <span aria-hidden="true" class="text-copper">&#10022;</span>
    </li>
  {%- endfor -%}
{%- endcapture -%}
<div class="overflow-hidden border-y border-ink/10 bg-parchment-deep py-4 font-display text-lg text-ink-soft md:text-xl">
  <div class="flex w-max motion-safe:animate-[ticker_60s_linear_infinite]">
    <ul class="flex shrink-0 items-center">{{ row }}</ul>
    <ul aria-hidden="true" class="flex shrink-0 items-center">{{ row }}</ul>
  </div>
</div>

{% schema %}
{
  "name": "Ticker",
  "tag": "section",
  "blocks": [
    { "type": "item", "name": "Word", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Non-comedogenic" }] }
  ],
  "presets": [{ "name": "Ticker", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
